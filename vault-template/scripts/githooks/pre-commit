#!/bin/sh
# Refresh the generated indexes on every commit, including Obsidian Git auto-commits.
# Enable once per clone with:  git config core.hooksPath scripts/githooks
# Needs Python; if Python is missing or fails, the hook is skipped so a commit never fails because of it.

cd "$(git rev-parse --show-toplevel)" || exit 0

if command -v py >/dev/null 2>&1; then
    PY="py -3"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
elif command -v python >/dev/null 2>&1; then
    PY="python"
else
    exit 0
fi

$PY scripts/build_index.py >/dev/null 2>&1 || exit 0
git add Index.md knowledge/_index.md projects/*/_index.md 2>/dev/null
exit 0
